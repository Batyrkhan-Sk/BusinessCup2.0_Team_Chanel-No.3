# Copy to .env.local and fill in. Every integration shows a clear "not configured"
# state while its variables are empty; nothing is faked.

# Neon Postgres (reminders, case snapshots, Guardian entitlements)
DATABASE_URL=

# Resend (reminder emails)
RESEND_API_KEY=
RESEND_FROM=DoseCost <reminders@your-verified-domain.com>

# Stripe (test mode): Guardian checkout
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (denial letter extraction, server-side only)
ANTHROPIC_API_KEY=

# Vercel Cron: shared secret sent as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Public base URL used in emails and Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
